<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0</TargetFrameworks>

		<PackageId>UltralightNet.AppCore</PackageId>
		<Description>AppCore bindings</Description>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Nullable>enable</Nullable>

		<!-- <PackageLicenseFile>LICENSE.txt</PackageLicenseFile> -->
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="LibraryImportGenerator/**" Condition="'$(TargetFramework)'=='net8.0'" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="System.ValueTuple" Version="4.5.0" PrivateAssets="All" />
		<ProjectReference Include="..\UltralightNet.AppCore.Binaries\UltralightNet.AppCore.Binaries.csproj" />
		<ProjectReference Include="..\UltralightNet\UltralightNet.csproj" />
	</ItemGroup>

</Project>
