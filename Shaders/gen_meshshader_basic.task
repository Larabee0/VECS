#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_ARB_shading_language_include : require
#include "common_structures.glsl"
#include "mesh_shader_structures.glsl"

layout(set = 0, binding = 0) readonly buffer CameraInfos {
	CameraInfo values[];
} cameraInfo;

layout(std140, set = 2, binding = 0) readonly buffer MeshletBuffer{
	Meshlet meshlets[];
} meshletsBuffer;

layout(std140, set = 2, binding = 1) readonly buffer BoundsBuffer{
	Bounds bounds[];
} boundsBuffer;

layout(push_constant) uniform pushConstant{
	uint cameraIndex;
    uint firstMeshlet;
    uint meshletCount;
};

layout (local_size_x=1, local_size_y=1, local_size_z=1) in;
void main()
{
	EmitMeshTasksEXT(meshletCount, 1, 1);
}
