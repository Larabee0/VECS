#version 460

#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

struct PointLight {
	vec4 position; // ignore w
	vec4 colour; // w is intensity
};

struct ObjectMatrices{
	mat4 modelMatrix; // project * view * model
	mat4 normalMatrix;
};

struct Meshlet{
    uint vertex_offset;
	uint triangle_offset;
	uint vertex_count;
	uint triangle_count;
};

layout(set = 0, binding = 0) uniform GlobalUbo{
	mat4 projectionMatrix;
	mat4 viewMatrix;
	mat4 inverseViewMatrix;
	vec4 ambientLightColour;
	int numLights;
	PointLight pointLights[10];
} ubo;

layout (std140, set = 1, binding = 0) buffer ObjectMatricesBuffer{
	ObjectMatrices matrices[];
} matricesBuffer;

layout(std140, set = 2, binding = 0) buffer MeshletBuffer{
	Meshlet meshlets[];
} meshletsBuffer;

// binding 1 is the bounds buffer

layout(std430, set = 2, binding = 2) buffer MeshletIndexBuffer{
	uint8_t indices[];
} indexBuffer;

layout(std140, set = 2, binding = 3) buffer VertexPositionBuffer{
	vec4 pos[];
} vertexPositionBuffer;


layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 64, max_primitives = 64) out;

layout(location = 0) out VertexOutput
{
	vec4 color;
} vertexOutput[];

void main()
{
	uint meshletIndex = gl_GlobalInvocationID.x;

    Meshlet meshlet = meshletsBuffer.meshlets[meshletIndex];
	
	SetMeshOutputsEXT(meshlet.vertex_count, meshlet.triangle_count);

	mat4 mvp = ubo.projectionMatrix * ubo.viewMatrix * matricesBuffer.matrices[0].modelMatrix;
    uvec3 triIndices;
    uint vertexOffset = meshlet.vertex_offset;
    uint indexOffset = meshlet.triangle_offset;

    for(uint i = 0; i < meshlet.vertex_count; i++)
    {
        gl_MeshVerticesEXT[i].gl_Position = ubo.projectionMatrix * ubo.viewMatrix * (matricesBuffer.matrices[0].modelMatrix * vec4(vertexPositionBuffer.pos[vertexOffset + i].xyz, 1.0));
        
	    vertexOutput[i].color = vec4(1);
    }
	uint index;
    for(uint i = 0; i < meshlet.triangle_count; i ++)
    {
		index = i * 3;
        gl_PrimitiveTriangleIndicesEXT[i] = uvec3(indexBuffer.indices[indexOffset + index + 0], indexBuffer.indices[indexOffset + index + 1], indexBuffer.indices[indexOffset + index + 2]);
    }
}
