<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  x:Class="VECS.UI.Matrix3x2Field"
  x:Name="Matrix3x2FieldControl"
  Height="200" Background="#004D5052">
  <UserControl.Resources>
    <ResourceDictionary Source="./EditorTheme.xaml"/>
  </UserControl.Resources>
  <Grid Height="200">
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Rectangle Grid.ColumnSpan="4" Fill="#FF262E35" Stroke="#FF000000"/>
    <Grid Margin="4,4,4,4" ColumnSpan="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="0.2*"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="0.2*"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="0.2*"/>
        <RowDefinition Height="0.2*"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="Label" Text="{Binding Label, ElementName=Matrix3x2FieldControl}" Grid.RowSpan="2" HorizontalAlignment="Left" Foreground="#FFFFFFFF" Style="{DynamicResource VectorLabel}"/>
      
      <TextBlock Text="M11" Grid.Column="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBox x:Name="M11Comp" Text="{Binding ValueM11, ElementName=Matrix3x2FieldControl}" Margin="0,0,2,0" Grid.Column="2" Style="{DynamicResource VectorStyle}"/>
      <TextBlock Text="M12" Grid.Column="3" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBox x:Name="M12Comp" Text="{Binding ValueM12, ElementName=Matrix3x2FieldControl}" Margin="2,0,2,0" Grid.Column="4" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      
      <TextBlock Text="M21" Grid.Column="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}" Grid.Row="1"/>
      <TextBox x:Name="M21Comp" Text="{Binding ValueM21, ElementName=Matrix3x2FieldControl}" Margin="0,0,2,0" Grid.Column="2" Style="{DynamicResource VectorStyle}" Grid.Row="1"/>
      <TextBlock Text="M22" Grid.Column="3" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}" Grid.Row="1"/>
      <TextBox x:Name="M22Comp" Text="{Binding ValueM22, ElementName=Matrix3x2FieldControl}" Margin="2,0,2,0" Grid.Column="4" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}" Grid.Row="1"/>
      
      <TextBlock Text="M31" Grid.Column="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}" Grid.Row="2"/>
      <TextBox x:Name="M31Comp" Text="{Binding ValueM31, ElementName=Matrix3x2FieldControl}" Margin="0,0,2,0" Grid.Column="2" Style="{DynamicResource VectorStyle}" Grid.Row="2"/>
      <TextBlock Text="M32" Grid.Column="3" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}" Grid.Row="2"/>
      <TextBox x:Name="M32Comp" Text="{Binding ValueM32, ElementName=Matrix3x2FieldControl}" Margin="2,0,2,0" Grid.Column="4" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}" Grid.Row="2"/>
      

    </Grid>
  </Grid>
</UserControl>