<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  x:Class="VECS.UI.Matrix3x2Field"
  x:Name="Matrix3x2FieldControl" Width="580" Height="160" Background="#004D5052">
  <UserControl.Resources>
    <ResourceDictionary Source="./EditorTheme.xaml"/>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Rectangle Grid.ColumnSpan="4" Fill="#FF262E35" Stroke="#FF000000"/>
    <Grid Margin="4,4,4,4" ColumnSpan="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="30"/>
        <ColumnDefinition Width="270"/>
        <ColumnDefinition Width="270"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="Label" Text="{Binding Label, ElementName=Matrix3x2FieldControl}" Grid.ColumnSpan="3" HorizontalAlignment="Left" Foreground="#FFFFFFFF" Style="{DynamicResource VectorLabel}"/>
      
      <TextBlock Text="MX1" Grid.Column="1" Grid.Row="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBlock Text="MX2" Grid.Column="2" Grid.Row="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBlock Text="M1X" Grid.Row="2" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBlock Text="M2X" Grid.Row="3" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBlock Text="M3X" Grid.Row="4" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBox x:Name="M11Comp" Text="{Binding ValueM11, ElementName=Matrix3x2FieldControl}" Width="264" Margin="0,0,2,0" Grid.Column="1" Grid.Row="2" Style="{DynamicResource VectorStyle}"/>
      <TextBox x:Name="M12Comp" Text="{Binding ValueM12, ElementName=Matrix3x2FieldControl}" Width="264" Margin="2,0,2,0" Grid.Column="2" Grid.Row="2" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      <TextBox x:Name="M21Comp" Text="{Binding ValueM21, ElementName=Matrix3x2FieldControl}" Width="264" Margin="0,0,2,0" Style="{DynamicResource VectorStyle}" Grid.Column="1" Grid.Row="3"/>
      <TextBox x:Name="M22Comp" Text="{Binding ValueM22, ElementName=Matrix3x2FieldControl}" Width="264" Margin="2,0,2,0" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}" Grid.Column="2" Grid.Row="3"/>
      <TextBox x:Name="M31Comp" Text="{Binding ValueM31, ElementName=Matrix3x2FieldControl}" Width="264" Margin="0,0,2,0" Style="{DynamicResource VectorStyle}" Grid.Column="1" Grid.Row="4"/>
      <TextBox x:Name="M32Comp" Text="{Binding ValueM32, ElementName=Matrix3x2FieldControl}" Width="264" Margin="2,0,2,0" Grid.Column="2" Grid.Row="4" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      

    </Grid>
  </Grid>
</UserControl>