<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="AssetRefTemplate"  TargetType="{x:Type VECS.UI.AssetRefField}">
    <Grid Width="580"
    Height="50" MinWidth="580" Background="#004D5052">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Rectangle Grid.ColumnSpan="1" Fill="#FF262E35" Stroke="#FF000000"/>
      <Grid Margin="4,4,4,4" ColumnSpan="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="245"/>
          <ColumnDefinition Width="280"/>
          <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Label" Text="{Binding Path=Label, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left" Foreground="#FFFFFFFF" Style="{DynamicResource VectorLabel}"/>
        <TextBlock x:Name="AssetName" Text="{Binding Path=AssetName, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=None}" Width="280" Grid.Column="1" Padding="5,10,5,10" Background="#FF11161B" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
        <Button x:Name="ChangeAssetButton" Width="40" Height="40" Grid.Column="2" Padding="0,0,0,0">
          <Path Stretch="Uniform" Width="30" Height="30" Fill="#FFF4F4F5" Stroke="#FF262E35" StrokeThickness="5" StrokeLineJoin="Bevel" StrokeMiterLimit="15" StrokeStartLineCap="Triangle" StrokeEndLineCap="Round" StrokeDashCap="Triangle">
            <Path.Data>
              <EllipseGeometry RadiusY="15" Center="15,15" RadiusX="15"/>
            </Path.Data>
          </Path>
        </Button>
      </Grid>
    </Grid>
  </ControlTemplate>

  <Style x:Key="VECS.UI.AssetRefField"  TargetType="{x:Type VECS.UI.AssetRefField}">
    <Setter Property="Template" Value="{StaticResource AssetRefTemplate}"/>
  </Style>
</ResourceDictionary>