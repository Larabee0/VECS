<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:system="clr-namespace:System"
  xmlns:system1="clr-namespace:System;assembly=mscorlib"
  mc:Ignorable="d"
  Background="#FF4D5052" d:DesignWidth="1280" d:DesignHeight="720">
  <Grid.Resources>
    <ResourceDictionary Source="./EditorTheme.xaml"/>
  </Grid.Resources>
  <Viewbox>
    <Grid Width="1920" Height="1080">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="0.33*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition Height="0.7*"/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.43*"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Rectangle x:Name="HierarchyViewBG" Grid.ColumnSpan="2" Fill="#FF0303FF" Stroke="#FF000000"/>
        <StackPanel x:Name="HierarchyContainer" Height="635" MaxHeight="635">
          <TreeView x:Name="HierarchyTreeView" MaxHeight="635"/>
        </StackPanel>
        <Rectangle x:Name="ViewPortBG" Grid.Column="1" Fill="#FF1FC200" Stroke="#FF000000"/>
        <Image x:Name="GameView" Grid.Column="1"/>
      </Grid>

      <Rectangle x:Name="RightSideBarBG" Grid.Column="1" Fill="#494d4a" Stroke="#FF000000" Grid.ColumnSpan="2" Grid.RowSpan="2"/>
      <StackPanel x:Name="RightSideBarStackPanel" Grid.Column="1" Grid.RowSpan="2" MaxWidth="476" MaxHeight="1080">
          <Viewbox>
            <TreeView x:Name="RightSideBarTreeView">
            </TreeView>
        </Viewbox>
      </StackPanel>

      <Rectangle x:Name="BottomProjectAreaBG" Grid.Row="1" Fill="#FFF4F4F5" Stroke="#FF000000"/>
      <Grid x:Name="BottomProjectAreaGrid" Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.35*"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="OutlineStack">
          <TreeView x:Name="OutlineTreeView" ScrollViewer.PanningMode="VerticalOnly"/>
        </StackPanel>
        <StackPanel x:Name="DirectoryStack" Grid.Column="1">
          <TreeView x:Name="DirectoryTreeView" ScrollViewer.PanningMode="VerticalOnly"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Viewbox>
</Grid>