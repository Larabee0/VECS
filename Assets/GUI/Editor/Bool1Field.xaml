<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="Bool1FieldTemplate"  TargetType="{x:Type VECS.UI.Bool1Field}">
    <Grid Height="50"  MinWidth="580" Background="#004D5052">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Rectangle Grid.ColumnSpan="1" Fill="#FF262E35" Stroke="#FF000000"/>
      <Grid Margin="4,4,4,4" ColumnSpan="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="245"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Label" Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left" Foreground="#FFFFFFFF" Style="{DynamicResource VectorLabel}"/>

        <CheckBox x:Name="XComp" IsChecked="{Binding ValueX, RelativeSource={RelativeSource TemplatedParent}}" Margin="2,0,2,0" Grid.Column="1" HorizontalAlignment="Left"/>
      </Grid>
    </Grid>
  </ControlTemplate>

  <Style x:Key="VECS.UI.Bool1Field"  TargetType="{x:Type VECS.UI.Bool1Field}">
    <Setter Property="Template" Value="{StaticResource Bool1FieldTemplate}"/>
  </Style>
</ResourceDictionary>