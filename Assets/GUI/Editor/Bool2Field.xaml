<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="Bool2FieldTemplate"  TargetType="{x:Type VECS.UI.Bool2Field}">
    <Grid Width="580"
    Height="50" MinWidth="580" Background="#004D5052">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Rectangle Grid.ColumnSpan="1" Fill="#FF262E35" Stroke="#FF000000"/>
      <Grid Margin="4,4,4,4" ColumnSpan="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="245"/>
          <ColumnDefinition Width="15"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="15"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Label" Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left" Foreground="#FFFFFFFF" Style="{DynamicResource VectorLabel}"/>
        
        <TextBlock Text="X" Grid.Column="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
        <TextBlock Text="Y" Grid.Column="3" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
        <CheckBox x:Name="XComp" IsChecked="{Binding ValueX, RelativeSource={RelativeSource TemplatedParent}}" Margin="2,0,2,0" Grid.Column="2" HorizontalAlignment="Left"/>
        <CheckBox x:Name="YComp" IsChecked="{Binding ValueY, RelativeSource={RelativeSource TemplatedParent}}" Margin="2,0,2,0" Grid.Column="4" />
      </Grid>
    </Grid>
  </ControlTemplate>
  <Style x:Key="VECS.UI.Bool2Field"  TargetType="{x:Type VECS.UI.Bool2Field}">
    <Setter Property="Template" Value="{StaticResource Bool2FieldTemplate}"/>
  </Style>
</ResourceDictionary>