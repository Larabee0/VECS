<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  x:Class="VECS.UI.Matrix4x4Field"
  x:Name="Matrix4x4FieldControl"
  Height="400" Background="#004D5052">
  <UserControl.Resources>
    <ResourceDictionary Source="./EditorTheme.xaml"/>
  </UserControl.Resources>
  <Grid Height="400">
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Rectangle Grid.ColumnSpan="4" Fill="#FF262E35" Stroke="#FF000000"/>
    <Grid Margin="4,4,4,4" ColumnSpan="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="0.2*"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="0.2*"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="0.2*"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="0.2*"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition Height="0.2*"/>
        <RowDefinition/>
        <RowDefinition Width="0.2*"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="M44Label" Text="{Binding Label, ElementName=Matrix4x4FieldControl}" HorizontalAlignment="Left" Foreground="#FFFFFFFF" Style="{DynamicResource VectorLabel}"/>
      <TextBlock Text="M11" Grid.Column="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBox x:Name="M11Comp" Text="{Binding ValueM11, ElementName=Matrix4x4FieldControl}" Margin="0,0,2,0" Grid.Column="2" Style="{DynamicResource VectorStyle}"/>
      <TextBlock Text="M12" Grid.Column="3" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBox x:Name="M12Comp" Text="{Binding ValueM12, ElementName=Matrix4x4FieldControl}" Margin="2,0,2,0" Grid.Column="4" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      <TextBlock Text="M13" Grid.Column="5" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBox x:Name="M13Comp" Text="{Binding ValueM13, ElementName=Matrix4x4FieldControl}" Margin="2,0,2,0" Grid.Column="6" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      <TextBlock Text="M14" Grid.Column="7" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBox x:Name="M14Comp" Text="{Binding ValueM14, ElementName=Matrix4x4FieldControl}" Margin="2,0,0,0" Grid.Column="8" TextWrapping="Wrap" Style="{StaticResource VectorStyle}"/>

      <TextBlock Text="M21" Grid.Column="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}" Grid.Row="1"/>
      <TextBox x:Name="M21Comp" Text="{Binding ValueM21, ElementName=Matrix4x4FieldControl}" Margin="0,0,2,0" Grid.Column="2" Style="{DynamicResource VectorStyle}" Grid.Row="1"/>
      <TextBlock Text="M22" Grid.Column="3" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}" Grid.Row="1"/>
      <TextBox x:Name="M22Comp" Text="{Binding ValueM22, ElementName=Matrix4x4FieldControl}" Margin="2,0,2,0" Grid.Column="4" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}" Grid.Row="1"/>
      <TextBlock Text="M23" Grid.Column="5" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}" Grid.Row="1"/>
      <TextBox x:Name="M23Comp" Text="{Binding ValueM23, ElementName=Matrix4x4FieldControl}" Margin="2,0,2,0" Grid.Column="6" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}" Grid.Row="1"/>
      <TextBlock Text="M24" Grid.Column="7" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}" Grid.Row="1"/>
      <TextBox x:Name="M24Comp" Text="{Binding ValueM24, ElementName=Matrix4x4FieldControl}" Margin="2,0,0,0" Grid.Column="8" TextWrapping="Wrap" Style="{StaticResource VectorStyle}" Grid.Row="1"/>

      <TextBlock Text="M31" Grid.Column="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}" Grid.Row="2"/>
      <TextBox x:Name="M31Comp" Text="{Binding ValueM31, ElementName=Matrix4x4FieldControl}" Margin="0,0,2,0" Grid.Column="2" Style="{DynamicResource VectorStyle}" Grid.Row="2"/>
      <TextBlock Text="M32" Grid.Column="3" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}" Grid.Row="2"/>
      <TextBox x:Name="M32Comp" Text="{Binding ValueM32, ElementName=Matrix4x4FieldControl}" Margin="2,0,2,0" Grid.Column="4" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}" Grid.Row="2"/>
      <TextBlock Text="M33" Grid.Column="5" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}" Grid.Row="2"/>
      <TextBox x:Name="M33Comp" Text="{Binding ValueM33, ElementName=Matrix4x4FieldControl}" Margin="2,0,2,0" Grid.Column="6" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}" Grid.Row="2"/>
      <TextBlock Text="M34" Grid.Column="7" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}" Grid.Row="2"/>
      <TextBox x:Name="M34Comp" Text="{Binding ValueM34, ElementName=Matrix4x4FieldControl}" Margin="2,0,0,0" Grid.Column="8" TextWrapping="Wrap" Style="{StaticResource VectorStyle}" Grid.Row="2"/>

      <TextBlock Text="M41" Grid.Column="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}" Grid.Row="3"/>
      <TextBox x:Name="M41Comp" Text="{Binding ValueM41, ElementName=Matrix4x4FieldControl}" Margin="0,0,2,0" Grid.Column="2" Style="{DynamicResource VectorStyle}" Grid.Row="3"/>
      <TextBlock Text="M42" Grid.Column="3" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}" Grid.Row="3"/>
      <TextBox x:Name="M42Comp" Text="{Binding ValueM42, ElementName=Matrix4x4FieldControl}" Margin="2,0,2,0" Grid.Column="4" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}" Grid.Row="3"/>
      <TextBlock Text="M43" Grid.Column="5" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}" Grid.Row="3"/>
      <TextBox x:Name="M43Comp" Text="{Binding ValueM43, ElementName=Matrix4x4FieldControl}" Margin="2,0,2,0" Grid.Column="6" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}" Grid.Row="3"/>
      <TextBlock Text="M44" Grid.Column="7" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}" Grid.Row="3"/>
      <TextBox x:Name="M44Comp" Text="{Binding ValueM44, ElementName=Matrix4x4FieldControl}" Margin="2,0,0,0" Grid.Column="8" TextWrapping="Wrap" Style="{StaticResource VectorStyle}" Grid.Row="3"/>
    </Grid>
  </Grid>
</UserControl>