<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  x:Class="VECS.UI.Matrix4x4Field"
  x:Name="Matrix4x4FieldControl" Width="580" Height="185" MinWidth="580" Background="#004D5052">
  <UserControl.Resources>
    <ResourceDictionary Source="./EditorTheme.xaml"/>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Rectangle Grid.ColumnSpan="4" Fill="#FF262E35" Stroke="#FF000000"/>
    <Grid Margin="4,4,4,4" ColumnSpan="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="30" MaxWidth="30"/>
        <ColumnDefinition Width="135" MaxWidth="135"/>
        <ColumnDefinition Width="135" MaxWidth="135"/>
        <ColumnDefinition Width="135" MaxWidth="135"/>
        <ColumnDefinition Width="135" MaxWidth="135"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="M44Label" Text="{Binding Label, ElementName=Matrix4x4FieldControl}" Grid.ColumnSpan="5" HorizontalAlignment="Left" Foreground="#FFFFFFFF" Style="{DynamicResource VectorLabel}"/>
      <TextBlock Text="M1X" Grid.Row="2" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBlock Text="M2X" Grid.Row="3" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBlock Text="M3X" Grid.Row="4" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBlock Text="M4X" Grid.Row="5" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBlock Text="MX1" Grid.Column="1" Grid.Row="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBlock Text="MX2" Grid.Column="2" Grid.Row="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBlock Text="MX3" Grid.Column="3" Grid.Row="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBlock Text="MX4" Grid.Column="4" Grid.Row="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBox x:Name="M11Comp" Text="{Binding ValueM11, ElementName=Matrix4x4FieldControl}" Width="131" Margin="0,0,2,0" Grid.Column="1" Grid.Row="2" Style="{DynamicResource VectorStyle}"/>
      <TextBox x:Name="M12Comp" Text="{Binding ValueM12, ElementName=Matrix4x4FieldControl}" Width="131" Margin="2,0,2,0" Grid.Column="2" Grid.Row="2" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      <TextBox x:Name="M13Comp" Text="{Binding ValueM13, ElementName=Matrix4x4FieldControl}" Width="131" Margin="2,0,2,0" Grid.Column="3" Grid.Row="2" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      <TextBox x:Name="M14Comp" Text="{Binding ValueM14, ElementName=Matrix4x4FieldControl}" Width="131" Margin="2,0,0,0" Grid.Column="4" Grid.Row="2" TextWrapping="Wrap" Style="{StaticResource VectorStyle}"/>
      <TextBox x:Name="M21Comp" Text="{Binding ValueM21, ElementName=Matrix4x4FieldControl}" Width="131" Margin="0,0,2,0" Style="{DynamicResource VectorStyle}" Grid.Column="1" Grid.Row="3"/>
      <TextBox x:Name="M22Comp" Text="{Binding ValueM22, ElementName=Matrix4x4FieldControl}" Width="131" Margin="2,0,2,0" Grid.Column="2" Grid.Row="3" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      <TextBox x:Name="M23Comp" Text="{Binding ValueM23, ElementName=Matrix4x4FieldControl}" Width="131" Margin="2,0,2,0" Grid.Column="3" Grid.Row="3" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      <TextBox x:Name="M24Comp" Text="{Binding ValueM24, ElementName=Matrix4x4FieldControl}" Width="131" Margin="2,0,0,0" Grid.Column="4" Grid.Row="3" TextWrapping="Wrap" Style="{StaticResource VectorStyle}"/>
      <TextBox x:Name="M31Comp" Text="{Binding ValueM31, ElementName=Matrix4x4FieldControl}" Width="131" Margin="0,0,2,0" Grid.Column="1" Grid.Row="4" Style="{DynamicResource VectorStyle}"/>
      <TextBox x:Name="M32Comp" Text="{Binding ValueM32, ElementName=Matrix4x4FieldControl}" Width="131" Margin="2,0,2,0" Grid.Column="2" Grid.Row="4" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      <TextBox x:Name="M33Comp" Text="{Binding ValueM33, ElementName=Matrix4x4FieldControl}" Width="131" Margin="2,0,2,0" Grid.Column="3" Grid.Row="4" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      <TextBox x:Name="M34Comp" Text="{Binding ValueM34, ElementName=Matrix4x4FieldControl}" Width="131" Margin="2,0,0,0" Grid.Column="4" Grid.Row="4" TextWrapping="Wrap" Style="{StaticResource VectorStyle}"/>
      <TextBox x:Name="M41Comp" Text="{Binding ValueM41, ElementName=Matrix4x4FieldControl}" Width="131" Margin="0,0,2,0" Grid.Column="1" Grid.Row="5" Style="{DynamicResource VectorStyle}"/>
      <TextBox x:Name="M42Comp" Text="{Binding ValueM42, ElementName=Matrix4x4FieldControl}" Width="131" Margin="2,0,2,0" Grid.Column="2" Grid.Row="5" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      <TextBox x:Name="M43Comp" Text="{Binding ValueM43, ElementName=Matrix4x4FieldControl}" Width="131" Margin="2,0,2,0" Grid.Column="3" Grid.Row="5" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      <TextBox x:Name="M44Comp" Text="{Binding ValueM44, ElementName=Matrix4x4FieldControl}" Width="131" Margin="2,0,0,0" Grid.Column="4" Grid.Row="5" TextWrapping="Wrap" Style="{StaticResource VectorStyle}"/>
    </Grid>
  </Grid>
</UserControl>