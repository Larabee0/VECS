<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="ButtonWithImageTemplate"  TargetType="{x:Type VECS.UI.ButtonWithImage}">
    <Grid  Height="55" MinWidth="580" Background="#004D5052">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Rectangle Grid.ColumnSpan="1" Fill="#FF262E35" Stroke="#FF000000"/>
      <Grid Margin="4,4,4,4" ColumnSpan="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="55"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Label" Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" Grid.Column="1" HorizontalAlignment="Left" Foreground="#FFFFFFFF" Style="{DynamicResource VectorLabel}"/>

        <Image x:Name="Icon" Width="50" Height="50" Source="{Binding Image, RelativeSource={RelativeSource TemplatedParent}}"/>

      </Grid>
    </Grid>
  </ControlTemplate>
  <Style x:Key="VECS.UI.ButtonWithImage"  TargetType="{x:Type VECS.UI.ButtonWithImage}">
    <Setter Property="Template" Value="{StaticResource ButtonWithImageTemplate}"/>
  </Style>
</ResourceDictionary>