<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  x:Class="VECS.UI.ButtonWithImage"
  x:Name="ButtonWithImageFieldControl" Height="55" MinWidth="580" Background="#004D5052">
  <UserControl.Resources>
    <ResourceDictionary Source="./EditorTheme.xaml"/>
  </UserControl.Resources>
  <Grid Height="55">
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Rectangle Grid.ColumnSpan="1" Fill="#FF262E35" Stroke="#FF000000"/>
    <Grid Margin="4,4,4,4" ColumnSpan="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="55"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Label" Text="{Binding Label, ElementName=ButtonWithImageFieldControl}" Grid.Column="1" HorizontalAlignment="Left" Foreground="#FFFFFFFF" Style="{DynamicResource VectorLabel}"/>
      
      <Image x:Name="Icon" Width="50" Height="50" />
      
    </Grid>
  </Grid>
</UserControl>