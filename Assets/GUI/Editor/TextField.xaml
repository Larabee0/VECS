<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="TextFieldTemplate"  TargetType="{x:Type VECS.UI.TextField}">
    <Grid Width="580" Height="50" Background="#004D5052">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Rectangle Grid.ColumnSpan="1" Fill="#FF262E35" Stroke="#FF000000"/>
      <Grid Margin="4,4,4,4" ColumnSpan="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="245"/>
          <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left" Foreground="#FFFFFFFF" Style="{DynamicResource VectorLabel}"/>

        <TextBox x:Name="XComp" Text="{Binding ValueX, RelativeSource={RelativeSource TemplatedParent}}" Width="327" Margin="0,0,2,0" Grid.Column="1" HorizontalAlignment="Left" Style="{DynamicResource TextLabel}"/>

      </Grid>
    </Grid>
  </ControlTemplate>
  <Style x:Key="VECS.UI.TextField"  TargetType="{x:Type VECS.UI.TextField}">
    <Setter Property="Template" Value="{StaticResource TextFieldTemplate}"/>
  </Style>
</ResourceDictionary>