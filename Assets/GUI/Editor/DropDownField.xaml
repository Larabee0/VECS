<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="DropDownFieldTemplate"  TargetType="{x:Type VECS.UI.DropDownField}">
    <Grid Width="580" MinWidth="580" MaxHeight="220" Background="#004D5052">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Rectangle Grid.ColumnSpan="1" Fill="#FF262E35" Stroke="#FF000000"/>
      <Grid Margin="4,4,4,4" ColumnSpan="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="245"/>
          <ColumnDefinition/>

        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left" Foreground="#FFFFFFFF" Style="{DynamicResource VectorLabel}"/>
        <ScrollViewer ScrollViewer.CanContentScroll="True" Grid.Column="1">
          <TreeView ScrollViewer.CanContentScroll="True">
            <TreeViewItem x:Name="RadioContainer" Header="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Visible" Margin="0,0,2,0"/>
          </TreeView>
        </ScrollViewer>
      </Grid>
    </Grid>
  </ControlTemplate>
  <Style x:Key="VECS.UI.DropDownField"  TargetType="{x:Type VECS.UI.DropDownField}">
    <Setter Property="Template" Value="{StaticResource DropDownFieldTemplate}"/>
  </Style>
</ResourceDictionary>