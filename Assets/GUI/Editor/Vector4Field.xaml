<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="Vector4FieldTemplate"  TargetType="{x:Type VECS.UI.Vector4Field}">
    <Grid Width="580" Height="50" Background="#004D5052">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Rectangle Grid.ColumnSpan="4" Fill="#FF262E35" Stroke="#FF000000"/>
      <Grid Margin="4,4,4,4" ColumnSpan="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="245" MaxWidth="245"/>
          <ColumnDefinition Width="15" MaxWidth="15"/>
          <ColumnDefinition Width="65" MaxWidth="65"/>
          <ColumnDefinition Width="15" MaxWidth="15"/>
          <ColumnDefinition Width="65" MaxWidth="65"/>
          <ColumnDefinition Width="15" MaxWidth="15"/>
          <ColumnDefinition Width="65" MaxWidth="65"/>
          <ColumnDefinition Width="15" MaxWidth="15"/>
          <ColumnDefinition Width="65" MaxWidth="65"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Label" Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left" Foreground="#FFFFFFFF" Style="{DynamicResource VectorLabel}"/>
        <TextBlock Text="X" Grid.Column="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
        <TextBlock Text="Y" Grid.Column="3" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
        <TextBlock Text="Z" Grid.Column="5" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
        <TextBlock Text="W" Grid.Column="7" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
        <TextBox x:Name="XComp" Text="{Binding ValueX, RelativeSource={RelativeSource TemplatedParent}}" Width="59" Margin="0,0,2,0" Grid.Column="2" Style="{DynamicResource VectorStyle}"/>
        <TextBox x:Name="YComp" Text="{Binding ValueY, RelativeSource={RelativeSource TemplatedParent}}" Width="59" Margin="2,0,2,0" Grid.Column="4" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
        <TextBox x:Name="ZComp" Text="{Binding ValueZ, RelativeSource={RelativeSource TemplatedParent}}" Width="59" Margin="2,0,2,0" Grid.Column="6" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
        <TextBox x:Name="WComp" Text="{Binding ValueW, RelativeSource={RelativeSource TemplatedParent}}" Width="59" Margin="2,0,0,0" Grid.Column="8" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      </Grid>
    </Grid>
  </ControlTemplate>
  <Style x:Key="VECS.UI.Vector4Field"  TargetType="{x:Type VECS.UI.Vector4Field}">
    <Setter Property="Template" Value="{StaticResource Vector4FieldTemplate}"/>
  </Style>
</ResourceDictionary>