<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  x:Class="VECS.UI.Vector4Field"
  x:Name="Vector4FieldControl"
  Height="50" Background="#004D5052">
  <UserControl.Resources>
    <ResourceDictionary Source="./EditorTheme.xaml"/>
  </UserControl.Resources>
  <Grid Height="50">
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Rectangle Grid.ColumnSpan="4" Fill="#FF262E35" Stroke="#FF000000"/>
    <Grid Margin="4,4,4,4" ColumnSpan="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" MaxWidth="200"/>
        <ColumnDefinition Width="15" MaxWidth="15"/>
        <ColumnDefinition Width="130" MaxWidth="130"/>
        <ColumnDefinition Width="15" MaxWidth="15"/>
        <ColumnDefinition Width="130" MaxWidth="130"/>
        <ColumnDefinition Width="15" MaxWidth="15"/>
        <ColumnDefinition Width="130" MaxWidth="130"/>
        <ColumnDefinition Width="15" MaxWidth="15"/>
        <ColumnDefinition Width="130" MaxWidth="130"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Label" Text="{Binding Label, ElementName=Vector4FieldControl}" HorizontalAlignment="Left" Foreground="#FFFFFFFF" Style="{DynamicResource VectorLabel}"/>
      <TextBlock Text="X" Grid.Column="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBox x:Name="XComp" Text="{Binding ValueX, ElementName=Vector4FieldControl}" Width="125" Margin="0,0,2,0" Grid.Column="2" Style="{DynamicResource VectorStyle}"/>
      <TextBlock Text="Y" Grid.Column="3" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBox x:Name="YComp" Text="{Binding ValueY, ElementName=Vector4FieldControl}" Width="125" Margin="2,0,2,0" Grid.Column="4" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      <TextBlock Text="Z" Grid.Column="5" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBox x:Name="ZComp" Text="{Binding ValueZ, ElementName=Vector4FieldControl}" Width="125" Margin="2,0,2,0" Grid.Column="6" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      <TextBlock Text="W" Grid.Column="7" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBox x:Name="WComp" Text="{Binding ValueW, ElementName=Vector4FieldControl}" Width="125" Margin="2,0,0,0" Grid.Column="8" TextWrapping="Wrap" Style="{StaticResource VectorStyle}"/>
    </Grid>
  </Grid>
</UserControl>