<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  x:Name="ComponentRoot" Height="50">
  <Grid >
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Rectangle Grid.ColumnSpan="4" Fill="#FFF4F4F5" Stroke="#FF000000"/>
    <Grid Margin="4,4,4,4" ColumnSpan="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="0.2*"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="0.2*"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="0.2*"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="0.2*"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="bigproperty name so loong it wont  fit" HorizontalAlignment="Left" Style="{DynamicResource VectorLabel}"/>
      <TextBlock Text="X" Grid.Column="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBox x:Name="XComp" Text="234234235345635901342-5" Margin="0,0,2,0" Grid.Column="2" Style="{DynamicResource VectorStyle.001}"/>
      <TextBlock Text="Y" Grid.Column="3" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBox x:Name="YComp" Text="0" Margin="2,0,2,0" Grid.Column="4" TextWrapping="Wrap" Style="{DynamicResource VectorStyle.001}"/>
      <TextBlock Text="Z" Grid.Column="5" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
      <TextBox x:Name="ZComp" Text="0" Margin="2,0,2,0" Grid.Column="6" TextWrapping="Wrap" Style="{DynamicResource VectorStyle.001}"/>
