<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  x:Class="VectorField"
  x:Name="VectorFieldControl"
  Height="50" Background="#004D5052">
  <UserControl.Resources>
    <ResourceDictionary Source="./EditorTheme.xaml"/>
  </UserControl.Resources>
  <Grid Height="50">
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Rectangle Grid.ColumnSpan="1" Fill="#FF262E35" Stroke="#FF000000"/>
    <Grid Margin="4,4,4,4" ColumnSpan="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="0.2*"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="0.2*"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="0.2*"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="0.2*"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="LabelV1" Text="{Binding LabelV1, ElementName=Vector1FieldControl}" HorizontalAlignment="Left" Foreground="#FFFFFFFF" Style="{DynamicResource VectorLabel}"/>
      
      <TextBox x:Name="XCompV1" Text="{Binding ValueXV1, ElementName=Vector1FieldControl}" Margin="0,0,2,0" Grid.Column="1" Style="{DynamicResource VectorStyle}"/>
      
    </Grid>
  </Grid>
</UserControl>