<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="VECS.UI.Vector1Field"
  x:Name="Vector1FieldControl" Width="580"
  Height="50" Background="#004D5052">
  <UserControl.Resources>
    <ResourceDictionary Source="./EditorTheme.xaml"/>
  </UserControl.Resources>
  <Grid Height="50">
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Rectangle Grid.ColumnSpan="1" Fill="#FF262E35" Stroke="#FF000000"/>
    <Grid Margin="4,4,4,4" ColumnSpan="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="245"/>
        <ColumnDefinition Width="330"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Label, ElementName=Vector1FieldControl}" HorizontalAlignment="Left" Foreground="#FFFFFFFF" Style="{DynamicResource VectorLabel}"/>
      
      <TextBox x:Name="XComp" Text="{Binding ValueX, ElementName=Vector1FieldControl}" Width="327" Margin="0,0,2,0" Grid.Column="1" HorizontalAlignment="Left" Style="{DynamicResource VectorStyle}"/>
      
    </Grid>
  </Grid>
</UserControl>