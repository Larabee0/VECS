<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="Matrix3x3FieldTemplate"  TargetType="{x:Type VECS.UI.Matrix3x3Field}">
    <Grid Width="580" Height="160" MinWidth="580" Background="#004D5052">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Rectangle Grid.ColumnSpan="4" Fill="#FF262E35" Stroke="#FF000000"/>
      <Grid Margin="4,4,4,4" ColumnSpan="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" MaxWidth="30"/>
          <ColumnDefinition Width="180"/>
          <ColumnDefinition Width="180"/>
          <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Label" Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" Grid.ColumnSpan="4" HorizontalAlignment="Left" Foreground="#FFFFFFFF" Style="{DynamicResource VectorLabel}"/>
        <TextBlock Text="M1X" Grid.Row="2" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
        <TextBlock Text="M2X" Grid.Row="3" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
        <TextBlock Text="M3X" Grid.Row="4" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
        <TextBlock Text="MX1" Grid.Column="1" Grid.Row="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
        <TextBlock Text="MX2" Grid.Column="2" Grid.Row="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
        <TextBlock Text="MX3" Grid.Column="3" Grid.Row="1" TextWrapping="Wrap" Style="{DynamicResource VectorLabel}"/>
        <TextBox x:Name="M11Comp" Text="{Binding ValueM11, RelativeSource={RelativeSource TemplatedParent}}" Width="175" Margin="0,0,2,0" Grid.Column="1" Grid.Row="2" Style="{DynamicResource VectorStyle}"/>
        <TextBox x:Name="M12Comp" Text="{Binding ValueM12, RelativeSource={RelativeSource TemplatedParent}}" Width="175" Margin="2,0,2,0" Grid.Column="2" Grid.Row="2" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
        <TextBox x:Name="M13Comp" Text="{Binding ValueM13, RelativeSource={RelativeSource TemplatedParent}}" Width="175" Margin="2,0,2,0" Grid.Column="3" Grid.Row="2" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
        <TextBox x:Name="M21Comp" Text="{Binding ValueM21, RelativeSource={RelativeSource TemplatedParent}}" Width="175" Margin="0,0,2,0" Style="{DynamicResource VectorStyle}" Grid.Column="1" Grid.Row="3"/>
        <TextBox x:Name="M22Comp" Text="{Binding ValueM22, RelativeSource={RelativeSource TemplatedParent}}" Width="175" Margin="2,0,2,0" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}" Grid.Column="2" Grid.Row="3"/>
        <TextBox x:Name="M23Comp" Text="{Binding ValueM23, RelativeSource={RelativeSource TemplatedParent}}" Width="175" Margin="2,0,2,0" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}" Grid.Column="4" Grid.Row="3"/>
        <TextBox x:Name="M31Comp" Text="{Binding ValueM31, RelativeSource={RelativeSource TemplatedParent}}" Width="175" Margin="0,0,2,0" Style="{DynamicResource VectorStyle}" Grid.Column="1" Grid.Row="4"/>
        <TextBox x:Name="M32Comp" Text="{Binding ValueM32, RelativeSource={RelativeSource TemplatedParent}}" Width="175" Margin="2,0,2,0" Grid.Column="2" Grid.Row="4" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
        <TextBox x:Name="M33Comp" Text="{Binding ValueM33, RelativeSource={RelativeSource TemplatedParent}}" Width="175" Margin="2,0,2,0" Grid.Column="3" Grid.Row="4" TextWrapping="Wrap" Style="{DynamicResource VectorStyle}"/>
      </Grid>
    </Grid>
  </ControlTemplate>
  <Style x:Key="VECS.UI.Matrix3x3Field"  TargetType="{x:Type VECS.UI.Matrix3x3Field}">
    <Setter Property="Template" Value="{StaticResource Matrix3x3FieldTemplate}"/>
  </Style>
</ResourceDictionary>