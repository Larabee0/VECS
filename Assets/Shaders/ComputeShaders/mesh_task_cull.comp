#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_ARB_shading_language_include : require
#extension GL_EXT_debug_printf : require
#include "../mesh_shader_structures.glsl"
#include "../common_structures.glsl"
#include "culling_helpers.glsl"
#include "../view_projection_amplification_helpers.glsl"

struct MeshIndirectDraw {
    uint groupCountsX;
    uint groupCountsY;
    uint groupCountsZ;
    uint start;
    uint count;
};

layout(std140, set = 0, binding = 0) readonly buffer ObjectBoundsBuffer {
	ObjectBounds bounds[];
} boundsBuffer;

layout(set = 0, binding = 1) buffer InstanceBuffer {
	MeshIndirectDraw Draws[];
} drawBuffer;

layout(std140, set = 0, binding = 2) buffer TaskCommands {
	MeshTaskCommand values[];
} meshTaskCommands;

layout(set = 0, binding = 3) uniform CullData {
	//vec4 frustum[6]; // data for left/right/top/bottom frustum planes
    mat4 viewProj[6];
	mat4 viewMatrix;
    vec4 sphere;
	vec2 pyramid;
	float zNear;
	float P00;
	float P11;
	uint drawCount;
    uint projectionSelect;
    uint16_t projectionIndex;
    uint16_t layerCount;
	uint8_t includeMask;
	uint8_t excludeMask;
	uint8_t cullMode;
    uint8_t cullShape;
} cullData;


layout(set = 0, binding = 4) buffer MeshTaskLocalCullInfo {
	MeshTaskCullData values[];
} meshTaskCullData;

shared uint paddedMeshlets;
shared uvec2 commandRange;
shared uint commandsPerThread;

layout(local_size_x = 128) in;
void main() {

    if(gl_LocalInvocationID.x == 0){
        paddedMeshlets = 0;
        commandRange = uvec2(drawBuffer.Draws[gl_WorkGroupID.x].start,drawBuffer.Draws[gl_WorkGroupID.x].count);
        commandsPerThread = GetComputeShaderGroupCount( commandRange.y, gl_WorkGroupSize.x);
    	//debugPrintfEXT("%u cullinfo global offset: %u | count: %u | per therad: %u", gl_WorkGroupID.x, commandRange.x, commandRange.y, commandsPerThread);
		
    }
    if(gl_GlobalInvocationID.x == 0){
        meshTaskCullData.values[0].viewProj[0] = cullData.viewProj[0];
        meshTaskCullData.values[0].viewProj[1] = cullData.viewProj[1];
        meshTaskCullData.values[0].viewProj[2] = cullData.viewProj[2];

        meshTaskCullData.values[0].viewProj[3] = cullData.viewProj[3];
        meshTaskCullData.values[0].viewProj[4] = cullData.viewProj[4];
        meshTaskCullData.values[0].viewProj[5] = cullData.viewProj[5];
        meshTaskCullData.values[0].includeMask = cullData.includeMask;
        meshTaskCullData.values[0].excludeMask = cullData.excludeMask;
        meshTaskCullData.values[0].cullMode = cullData.cullMode;
        
        meshTaskCullData.values[0].maxLayers = cullData.layerCount;
        meshTaskCullData.values[0].projectionBufferSelect = uint8_t(cullData.projectionSelect);
        meshTaskCullData.values[0].projectionBufferOffset = cullData.projectionIndex;
    }

    barrier();

	if((commandRange.y == 0 || commandsPerThread == 0) && gl_LocalInvocationID.x != 0){
        return;
    }

    uint localOffset = commandRange.x +( gl_LocalInvocationID.x * commandsPerThread);
    uint count = localOffset + commandsPerThread;
    uint max = commandRange.x + commandRange.y;
    

    if(localOffset >= max){
        count = 0;
    }

    if(count > max) {
        count = max;
    }

    if(count == 0 && gl_LocalInvocationID.x != 0) return;
    //debugPrintfEXT("%u %u cullinfo localOffset: %u | Count: %u | Max: %u", gl_WorkGroupID.x, gl_LocalInvocationID.x, localOffset, count, max);
    bvec4 cullModeInfo;
    ObjectBounds bounds;
    uint cullShape = uint(cullData.cullShape);
    uint16_t viewMask = Layer_Project_None;

    for(uint i = localOffset; i < count; i++) {

		cullModeInfo = cullingMode(meshTaskCommands.values[i].layerFlags, cullData.includeMask, cullData.excludeMask, cullData.cullMode);
        bounds = boundsBuffer.bounds[meshTaskCommands.values[i].absMatrixIndex];

        if(cullModeInfo.x && cullModeInfo.y) {
            
            switch(cullShape){
                case 0:

                    for(uint i = 0; i < cullData.layerCount; i++) {
                        cullModeInfo.x = IsVisible(
                            bounds,
                            cullModeInfo.z,
                            cullData.viewProj[i]
                        );

				        viewMask |= (GetLayerProjectBitMask(i) * uint16_t(cullModeInfo.x ));
                    }

                break;
                case 1:
                    // for cubemap point lights, task y = cubemap faces (6), culled by this compute shader
                    // should work exactly the same as directional lights where the layer control is passed to the task shader and it doesnt emit meshlets per layer
                    
                    // for filed point lights as each face is a quad on the same layer we cull for the radius of the light
                    // the task shader emits meshlets per light rather than per viewprojection matrix
                    // the mesh shader sets its output to 0 for meshlets not within its the view bounds
                    // for point tiled lights, task y = num point lights for tiled Pointlights culled by this compute shader
                    // task shader wont emit meshlets per light
                    // task shader culls per light view matrix but has to launch 4 mesh shaders in y axis for tiled pointlights
                    // mesh shader culls tris per face of the point light tetraheadron
                    cullModeInfo.x = AABB_Intersects_Sphere(bounds,
                            cullData.sphere);

                    viewMask = Layer_Project_0;
                break;
            }
        }

        if(cullModeInfo.x) {
            meshTaskCommands.values[i].taskStartOffset = atomicAdd(
                paddedMeshlets,
                GetComputeShaderGroupCount(meshTaskCommands.values[i].meshletCount, TASK_LOCAL_SIZE_X)
            );
            meshTaskCommands.values[i].viewMask = viewMask;
        }
        else {
            meshTaskCommands.values[i].taskStartOffset = TASK_COMMAND_SKIP;
        }
    }

    barrier();
    if(gl_LocalInvocationID.x == 0){
        drawBuffer.Draws[gl_WorkGroupID.x].groupCountsX = paddedMeshlets;
        drawBuffer.Draws[gl_WorkGroupID.x].groupCountsY = cullData.layerCount;
        drawBuffer.Draws[gl_WorkGroupID.x].groupCountsZ = 1;
    }
}