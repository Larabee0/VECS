#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_ARB_shading_language_include : require
#include "../common_structures.glsl"
#include "culling_helpers.glsl"
#include "compute_texture_functions.glsl"

struct DrawCommand {
	uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
    uint absMatrixIndex;
	uint8_t layerFlags;
};

layout(std140, set = 0, binding = 0) readonly buffer ObjectBoundsBuffer {
	ObjectBounds bounds[];
} boundsBuffer;

layout(std140, set = 0, binding = 1) buffer InstanceBuffer {
	DrawCommand Draws[];
} drawBuffer;

layout(set = 0, binding = 2) uniform sampler2D depthPyramid;

layout(set = 0, binding = 3) uniform CullData{
	// vec4 frustum[6]; // data for left/right/top/bottom frustum planes
	mat4 viewProj[6];
	mat4 viewMatrix;
	vec4 pyramid;
	float zNear;
	float P00;
	float P11;
	uint sphereCount;
	uint drawCount;
    uint projectionSelect;
    uint16_t projectionIndex;
    uint16_t layerCount;
	uint8_t includeMask;
	uint8_t excludeMask;
	uint8_t cullMode;
    uint8_t cullShape;
} cullData;

#define FLT_MAX 3.402823466e+38

void CalculateMinMax(vec4 bmin, vec4 bmax, out vec2 min_xy, out vec2 max_xy, out float min_z) {
	vec3 corners[8]=
	{
        vec3(bmin.x, bmin.y, bmin.z),
        vec3(bmin.x, bmin.y, bmax.z),
        vec3(bmin.x, bmax.y, bmin.z),
        vec3(bmin.x, bmax.y, bmax.z),
        vec3(bmax.x, bmin.y, bmin.z),
        vec3(bmax.x, bmin.y, bmax.z),
        vec3(bmax.x, bmax.y, bmin.z),
        vec3(bmax.x, bmax.y, bmax.z)
	};

	min_xy = vec2(FLT_MAX);
	max_xy = vec2(-FLT_MAX);
	min_z = 1.0;

	for(int i = 0; i < 8; i++){
		vec4 worldSpace = vec4(corners[i],1.0);
		vec4 clipSpace = cullData.viewProj[0] * worldSpace;

		vec3 ndcSpace = clipSpace.xyz / clipSpace.w;

		vec3 uvSpace = vec3((ndcSpace.x + 1) * 0.5, (1 - ndcSpace.y) * 0.5,(ndcSpace.z));

		min_xy = min(min_xy, uvSpace.xy);
		max_xy = max(max_xy, uvSpace.xy);
		min_z = min(min_z, uvSpace.z);
		
	}
}


float sampleSingle(sampler2D srcMip, vec2 uv, float mipLevel){
	return textureLod(srcMip, ClampAndScaleUV(uv, cullData.pyramid.zw,0.25, cullData.pyramid.zw), mipLevel).x;
}

bool IsDepthVisible(uint objectIndex){

	ObjectBounds bounds = boundsBuffer.bounds[objectIndex];

	vec4 bmin = bounds.bMin;
	float cullOveride = bmin.w;
	if(cullOveride >= 2) return true;

	vec4 bmax = bounds.bMax;


	vec2 min_xy;
	vec2 max_xy;
	float min_z;

	CalculateMinMax(bmin, bmax, min_xy, max_xy, min_z);
	vec4 cameraClipSpace = cullData.viewProj[0][3];

	bool containsCamera = all(greaterThanEqual(cullData.viewMatrix[0].xyz,bmin.xyz)) && all(lessThanEqual(cullData.viewMatrix[0].xyz,bmax.xyz));
	if(containsCamera) {
		return true;
	}
	vec2 boxWidth = max_xy - min_xy;
	vec2 texelSize = boxWidth * cullData.pyramid.xy;
	float maxDimention = max(texelSize.x, texelSize.y);
	
	float mip = floor(log2(maxDimention));
	mip = min(mip, 8);

	vec4 box = vec4(min_xy, max_xy);

	float sample1 = sampleSingle(depthPyramid, box.xy, mip).x;
	float sample2 = sampleSingle(depthPyramid, box.zy, mip).x;
	float sample3 = sampleSingle(depthPyramid, box.xw, mip).x;
	float sample4 = sampleSingle(depthPyramid, box.zw, mip).x;

	float max_z = max(max(max(sample1, sample2), sample3), sample4);

	return ( min_z) <= max_z +0.02;
	
	//return true;
}


layout(local_size_x = 64) in;
void main() {
	uint gID = gl_GlobalInvocationID.x;
	if(gID < cullData.drawCount)
	{
		bvec4 cullModeInfo = cullingMode(drawBuffer.Draws[gID].layerFlags, cullData.includeMask, cullData.excludeMask, cullData.cullMode);

		if(cullModeInfo.x && cullModeInfo.y){
			cullModeInfo.x = IsVisible(
				boundsBuffer.bounds[drawBuffer.Draws[gID].absMatrixIndex],
				cullModeInfo.z,
				cullData.viewProj[0]
			);
		}
		if(cullModeInfo.x && cullModeInfo.w){
			cullModeInfo.x = IsDepthVisible(drawBuffer.Draws[gID].absMatrixIndex);
		}
		
		if(cullModeInfo.x){
			drawBuffer.Draws[gID].instanceCount = 1;
		}
		else{
			drawBuffer.Draws[gID].instanceCount = 0;
		}
	}
}