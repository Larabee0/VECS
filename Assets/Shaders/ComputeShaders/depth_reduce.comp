#version 460
#extension GL_ARB_shading_language_include : require
#extension GL_EXT_nonuniform_qualifier : require
#include "compute_texture_functions.glsl"

layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

layout(binding = 0, r16f) uniform writeonly image2D dstImage[16];
layout(binding = 1) uniform sampler2D srcImage[16];

layout(push_constant) uniform block {
	vec4 srcImageSize;
	vec4 dstImageSize;
	vec2 renderScale;
	int srcIndex;
	int dstIndex;
};

float sampleSingle(sampler2D srcMip, vec2 uv){
	return texture(srcMip, ClampAndScaleUV(uv, srcImageSize.zw,0.25, renderScale)).x;
}

float sampleMip(sampler2D srcMip, vec2 uv, float Src, vec2 offset1, vec2 offset2, vec2 offset3, vec2 offset4, vec2 off) {
	
    Src = max(max(max(sampleSingle(srcMip, uv + offset1),
            max(sampleSingle(srcMip, uv + offset2),
                max(sampleSingle(srcMip, uv + offset3),
                    sampleSingle(srcMip, uv + offset4)))),
            max(sampleSingle(srcMip, uv + offset1 + vec2(off.x, 0.0)),
                max(sampleSingle(srcMip, uv + offset2 + vec2(off.x, 0.0)),
                    max(sampleSingle(srcMip, uv + offset3 + vec2(off.x, 0.0)),
                        sampleSingle(srcMip, uv + offset4 + vec2(off.x, 0.0)))))),
            
          max(max(sampleSingle(srcMip, uv + offset1 + vec2(0.0, off.y)),
            max(sampleSingle(srcMip, uv + offset2 + vec2(0.0, off.y)),
                max(sampleSingle(srcMip, uv + offset3 + vec2(0.0, off.y)),
                    sampleSingle(srcMip, uv + offset4 + vec2(0.0, off.y))))),
            max(sampleSingle(srcMip, uv + offset1 + vec2(off.x, off.y)),
                max(sampleSingle(srcMip, uv + offset2 + vec2(off.x, off.y)),
                    max(sampleSingle(srcMip, uv + offset3 + vec2(off.x, off.y)),
                        sampleSingle(srcMip, uv + offset4 + vec2(off.x, off.y)))))));
	return Src;
}

#define FLT_MAX 3.402823466e+38
void main()
{
    PositionInputs posInputs = GetPositionInput(vec2(gl_GlobalInvocationID.xy), dstImageSize.zw, uvec2(32, 32));
	if(any(greaterThan( posInputs.positionSS, dstImageSize.xy))) return;

    vec2 uv =  dstImageSize.zw  * (vec2(posInputs.positionSS) + vec2(0.25,0.25));

	vec2 off = dstImageSize.zw * 0.5;

	vec2 offset1 = vec2(0.0);
	vec2 offset2 = vec2(off.x, 0.0);
	vec2 offset3 = vec2(0.0, off.y);
	vec2 offset4 = off;

	float src = sampleMip(srcImage[srcIndex], uv, -FLT_MAX, offset1, offset2, offset3, offset4, off);


	imageStore(dstImage[dstIndex], ivec2(posInputs.positionSS), vec4(src));
}