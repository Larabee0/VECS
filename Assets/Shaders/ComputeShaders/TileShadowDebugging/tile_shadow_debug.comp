layout(set = 0, binding = 4) uniform  FaceVectors{
    vec4 faceA;
    vec4 faceB;
    vec4 faceC;
    vec4 faceD;
} faceVectors;

layout(std140, set = 0, binding = 5) readonly buffer TetraShadowMats{
    mat4 value[];
} tetraShadowMats;

const vec3 tetrahedronPlanes[12] = vec3[](

