#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_ARB_shading_language_include : require
#extension GL_EXT_debug_printf : require
#include "../../common_structures.glsl"
#include "../../mesh_shader_structures.glsl"
#include "../../ComputeShaders/culling_helpers.glsl"

layout (std140, set = 0, binding = 0) readonly buffer ObjectMatricesBuffer{
	ObjectMatrices matrices[];
} matricesBuffer;

layout(set = 1, binding = 0) readonly buffer CameraDatas {
	CameraData values[];
} cameraData;


layout(std140, set = 2, binding = 0) buffer MeshletBuffer{
	Meshlet meshlets[];
} meshletsBuffer;

layout(std140, set = 2, binding = 1) readonly buffer BoundsBuffer{
	ObjectBounds bounds[];
} meshletBoundsBuffer;

layout(std140, set = 3, binding = 0) readonly buffer TaskCommands{
	MeshTaskCommand values[];
} taskCommands;

layout(set = 3, binding = 1) readonly buffer MeshTaskLocalCullInfo {
	MeshTaskCullData values[];
} meshTaskCullData;

layout(push_constant) uniform pushConstant{
	uint cameraIndex;
    int matrixStartIndex;
    int bufferSelect;
	int taskOffset;
    int taskCount;
} constants;

taskPayloadSharedEXT MeshTaskPayload payload;


shared uint localMeshletCount;

layout (local_size_x = TASK_LOCAL_SIZE_X, local_size_y = 1) in;
void main(){
	MeshTaskCommand command;
	uint taskIndex = 0;
	if(gl_LocalInvocationID.x == 0){
		payload.meshletCount = 0;
		uint taskStartOffset;
		uint endRange;
		for(uint i = constants.taskOffset; i < constants.taskCount; i++){
			command = taskCommands.values[i];
			taskStartOffset = command.taskStartOffset;
			endRange = taskStartOffset + GetComputeShaderGroupCount(command.meshletCount,TASK_LOCAL_SIZE_X);
			if(gl_WorkGroupID.x >= taskStartOffset && gl_WorkGroupID.x < endRange){
				payload.taskIndex = i;
				
				localMeshletCount = (endRange - 1 == gl_WorkGroupID.x) 
					? (command.meshletCount - ((gl_WorkGroupID.x - taskStartOffset) * TASK_LOCAL_SIZE_X))
					: TASK_LOCAL_SIZE_X;
				break;
			}
		}

    	//debugPrintfEXT("%u = WG task info global pyload.taskIndex: %u | shared localMeshletCount: %u", gl_WorkGroupID.x, payload.taskIndex, localMeshletCount);
		
	}
	barrier();

	
	
	if(gl_LocalInvocationID.x < localMeshletCount) {
		taskIndex = payload.taskIndex;
		command = taskCommands.values[taskIndex];
		uint meshletOffset = gl_WorkGroupID.x - command.taskStartOffset;
		uint meshletIndex = gl_LocalInvocationID.x + (meshletOffset*TASK_LOCAL_SIZE_X);
		//debugPrintfEXT("%u %u task %u meshRange offset %u index %u count %u", gl_WorkGroupID.x, gl_LocalInvocationID.x, taskIndex, meshletOffset, meshletIndex, localMeshletCount);
		meshletIndex += command.meshletOffset;
    	Meshlet meshlet = meshletsBuffer.meshlets[meshletIndex];
		MeshTaskCullData cullInfo = meshTaskCullData.values[0];
		bvec4 cullModeInfo = cullingMode(command.layerFlags, cullInfo.includeMask, cullInfo.excludeMask, cullInfo.cullMode);

        if(cullModeInfo.x && cullModeInfo.y) {
            cullModeInfo.x = IsVisible(
				TransformAABB(meshletBoundsBuffer.bounds[meshletIndex], matricesBuffer.matrices[command.localMatrixIndex].modelMatrix),
                cullModeInfo.z ? 6 : 4,
                cullInfo.frustum
            );
			//cullModeInfo.x = true;
        }
		if(cullModeInfo.x) {
    		uint verticesPerInvoke = GetPerInvoke(meshlet.vertex_count);
    		uint trianglesPerInvoke = GetPerInvoke(meshlet.triangle_count);

			MeshletInfo info = {
				meshletIndex,
				uint16_t(verticesPerInvoke),
				uint16_t(trianglesPerInvoke)
			};

			uint index = atomicAdd(payload.meshletCount, 1);
			payload.perMeshlet[index] = info;

    		//debugPrintfEXT("%u %u meshletIndex %u", gl_WorkGroupID.x, gl_GlobalInvocationID.x, payload.perMeshlet[index].index);
			
		}
	}

	barrier();
	if(gl_LocalInvocationID.x == 0)
	{
		uint invocationsSoFar = gl_WorkGroupID.x * TASK_LOCAL_SIZE_X;
		uint originalMeshletCount = payload.meshletCount; 
		payload.meshletCount = min(payload.meshletCount, command.meshletCount - invocationsSoFar);
		payload.meshletOffset = invocationsSoFar;
		payload.TaskGroupID = gl_WorkGroupID.x;
		payload.taskIndex = taskIndex;
		

    	//debugPrintfEXT("%u %u emit meshlets %u | %u", gl_WorkGroupID.x, gl_GlobalInvocationID.x, payload.meshletCount, originalMeshletCount);
		EmitMeshTasksEXT(payload.meshletCount, 1, 1);
	}
}