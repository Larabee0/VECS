#version 460

#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_ARB_shading_language_include : require
#extension GL_EXT_debug_printf : require
#include "../../common_structures.glsl"
#include "../../mesh_shader_structures.glsl"

taskPayloadSharedEXT MeshTaskPayload payload;

out gl_MeshPerVertexEXT {
  vec4  gl_Position;
  float gl_ClipDistance[3];
} gl_MeshVerticesEXT[];

layout(triangles, max_vertices = 64, max_primitives = 64) out;

layout(location = 0) out vec2 fragUV[];

layout (std140, set = 0, binding = 0) readonly buffer ObjectMatricesBuffer{
	ObjectMatrices matrices[];
} matricesBuffer;

layout(std140, set = 1, binding = 0) readonly buffer CameraDatas {
	CameraData values[];
} cameraData;

layout(std140, set = 1, binding = 1) readonly buffer DirectionalShadowMats{
    mat4 value[];
} directionalShadowsMats;

layout(std140, set = 1, binding = 2) readonly buffer PointShadowMats{
    mat4 value[];
} pointShadowsMats;

layout(std140, set = 1, binding = 3) readonly buffer SpotShadowMats{
    mat4 value[];
} spotShadowsMats;

layout(std140, set = 1, binding = 4) readonly buffer TetraShadowMats{
    mat4 value[];
} tetraShadowMats;

layout(std140, set = 1, binding = 5) readonly buffer TetraShadowPlanes{
    vec3 value[];
} tetraShadowPlanes;

layout(std140, set = 2, binding = 0) readonly buffer MeshletBuffer{
	Meshlet meshlets[];
} meshletsBuffer;

layout(std430, set = 2, binding = 2) readonly buffer MeshletIndexBuffer{
	uint8_t indices[];
} indexBuffer;

layout(std140, set = 2, binding = 3) readonly buffer VertexPositionBuffer{
	vec4 pos[];
} vertexPositionBuffer;

layout(std430, set = 2, binding = 4) readonly buffer VertexUVBuffer{
	vec2 uv[];
} vertexTexCoord0Buffer;

layout(std140, set = 3, binding = 0) readonly buffer TaskCommands{
	MeshTaskCommand values[];
} taskCommands;

layout(push_constant) uniform pushConstant{
	uint cameraIndex;
    int matrixStartIndex;
    int bufferSelect;
	int taskOffset;
    int taskCount;
} constants;

mat4 getTransform(int bufferSelect, int bufferOffset) {
    switch(bufferSelect){
        case 0:
            return cameraData.values[max(bufferOffset,int(constants.cameraIndex))].projectionViewMatrix;
        case 1:
            return directionalShadowsMats.value[bufferOffset];
        case 2:
            return pointShadowsMats.value[bufferOffset];
        case 3:
            return spotShadowsMats.value[bufferOffset];
        case 4:
            return tetraShadowMats.value[bufferOffset];
        default:
            return mat4(1.0);
    }
}

float GetClipDist(vec3 positionWorld, int planeIndex){
    const vec3 lightPos = vec3(-8, 1, 0);

    vec3 normal = tetraShadowPlanes.value[planeIndex];
    return (dot(positionWorld,normal)+dot(-normal,lightPos));
}

vec3 getClipDist(vec3 positionWorld){
    if(constants.bufferSelect == 4) {
        int faceIndex = constants.matrixStartIndex;
        int planeIndex = 3 * constants.matrixStartIndex;
        const vec3 lightPos = vec3(-8, 1, 0);
        
        return vec3(
            GetClipDist(positionWorld.xyz, planeIndex),
            GetClipDist(positionWorld.xyz, planeIndex + 1),
            GetClipDist(positionWorld.xyz, planeIndex + 2)
        );
    }
    else {
        return vec3(1.0);
    }
}

layout(local_size_x = 64, local_size_y = 1) in;
void main(){
    uint tci = constants.taskOffset + payload.localTaskOffset;
    uint taskCount = constants.taskCount;
    uint globalInvoke = gl_GlobalInvocationID.x;
    
    MeshTaskCommand taskCommand = taskCommands.values[tci];
    //debugPrintfEXT("WorkGroupID  %u",  gl_WorkGroupID.x);
    //debugPrintfEXT("task_WorkGroupID  %u",  payload.A);

    while(globalInvoke >= taskCommand.meshletCount){
        tci++;

        if(tci >= taskCount){
            debugPrintfEXT("aborted");
            SetMeshOutputsEXT(0,0);
            return;
        }
        globalInvoke -= taskCommand.meshletCount;
        taskCommand = taskCommands.values[min(constants.taskCount-1,tci)];
    }
    //debugPrintfEXT("while tci %u", tci);

    uint ptci = (payload.A * 8) + gl_LocalInvocationID.x;

    debugPrintfEXT("payloadTaskOffset %u | tci %u | gl_WGID %u", payload.localTaskOffset, tci, gl_WorkGroupID.x);

    SetMeshOutputsEXT(0,0);
    return;

    //debugPrintfEXT("taskCommandIndex %u", tci);
    //debugPrintfEXT("meshletIndex %u", taskCommand.meshletOffset + globalInvoke);
    //debugPrintfEXT("globalInvoke %u",  gl_GlobalInvocationID.x);
    if(tci >= constants.taskCount){
    }
    taskCommand = taskCommands.values[0];
	uint meshletIndex =  0;

    if(meshletIndex >= taskCommand.meshletCount){
        SetMeshOutputsEXT(0,0);
        return;
    }
    //meshletIndex += taskCommand.meshletOffset;
    //debugPrintfEXT("meshletIndex %u", meshletIndex);
    Meshlet meshlet = meshletsBuffer.meshlets[meshletIndex];
    uvec3 triIndices;
    vec4 positionWorld;
    vec3 clipDist;
    uint vertexOffset = taskCommand.vertexStartIndex + meshlet.vertex_offset;
    uint indexOffset = taskCommand.triangleStartIndex + meshlet.triangle_offset;
    uint index;
    vec2 uv;
    
    mat4 viewProjection = getTransform(constants.bufferSelect, constants.matrixStartIndex);
    mat4 modelMatrix = matricesBuffer.matrices[taskCommand.absMatrixIndex].modelMatrix;

	SetMeshOutputsEXT(meshlet.vertex_count, meshlet.triangle_count);

    for(uint i = 0; i < meshlet.vertex_count; i++){
        positionWorld = modelMatrix * vec4(vertexPositionBuffer.pos[vertexOffset + i].xyz, 1.0);
        uv = vertexTexCoord0Buffer.uv[vertexOffset + i];
        clipDist = getClipDist(positionWorld.xyz);
        gl_MeshVerticesEXT[i].gl_Position = viewProjection * positionWorld;
        gl_MeshVerticesEXT[i].gl_ClipDistance[0] = clipDist.x;
        gl_MeshVerticesEXT[i].gl_ClipDistance[1] = clipDist.x;
        gl_MeshVerticesEXT[i].gl_ClipDistance[2] = clipDist.x;

        fragUV[i] = vec2(gl_GlobalInvocationID.x,0);
    }

    for(uint i = 0; i < meshlet.triangle_count; i++){
        index = i * 3;
        triIndices = uvec3(
            indexBuffer.indices[indexOffset + index + 0],
            indexBuffer.indices[indexOffset + index + 1],
            
            indexBuffer.indices[indexOffset + index + 2]
        );
        gl_PrimitiveTriangleIndicesEXT[i] = triIndices;
    }
}