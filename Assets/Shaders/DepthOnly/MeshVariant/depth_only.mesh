#version 460

#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_ARB_shading_language_include : require
#extension GL_EXT_debug_printf : require
#include "../../common_structures.glsl"
#include "../../mesh_shader_structures.glsl"

taskPayloadSharedEXT MeshTaskPayload payload;

out gl_MeshPerVertexEXT {
  vec4  gl_Position;
  float gl_ClipDistance[3];
} gl_MeshVerticesEXT[];

layout(triangles, max_vertices = MAX_MESH_VTX, max_primitives = MAX_MESH_TRIS) out;

layout(location = 0) out vec2 fragUV[];

shared vec3 vertexClipNDC [MAX_MESH_VTX];

layout (std140, set = 0, binding = 0) readonly buffer ObjectMatricesBuffer{
	ObjectMatrices matrices[];
} matricesBuffer;

layout(std140, set = 1, binding = 0) readonly buffer CameraDatas {
	CameraData values[];
} cameraData;

layout(std140, set = 1, binding = 1) readonly buffer DirectionalShadowMats{
    mat4 value[];
} directionalShadowsMats;

layout(std140, set = 1, binding = 2) readonly buffer PointShadowMats{
    mat4 value[];
} pointShadowsMats;

layout(std140, set = 1, binding = 3) readonly buffer SpotShadowMats{
    mat4 value[];
} spotShadowsMats;

layout(std140, set = 1, binding = 4) readonly buffer TetraShadowMats{
    mat4 value[];
} tetraShadowMats;

layout(std140, set = 1, binding = 5) readonly buffer TetraShadowPlanes{
    vec3 value[];
} tetraShadowPlanes;

layout(std140, set = 2, binding = 0) readonly buffer MeshletBuffer{
	Meshlet meshlets[];
} meshletsBuffer;

layout(std430,set = 2, binding = 2) readonly buffer MeshletIndexBuffer{
	uint8_t indices[];
} indexBuffer;

layout(std140, set = 2, binding = 3) readonly buffer VertexPositionBuffer{
	vec4 pos[];
} vertexPositionBuffer;

layout(std430, set = 2, binding = 4) readonly buffer VertexUVBuffer{
	vec2 uv[];
} vertexTexCoord0Buffer;

layout(std140, set = 3, binding = 0) readonly buffer TaskCommands{
	MeshTaskCommand values[];
} taskCommands;

layout(set = 3, binding = 1) readonly buffer MeshTaskLocalCullInfo {
	MeshTaskCullData values[];
} meshTaskCullData;

mat4 getTransform(uint bufferSelect, uint bufferOffset) {
    switch(bufferSelect){
        case 0:
            return cameraData.values[bufferOffset].projectionViewMatrix;
        case 1:
            return directionalShadowsMats.value[bufferOffset];
        case 2:
            return pointShadowsMats.value[bufferOffset];
        case 3:
            return spotShadowsMats.value[bufferOffset];
        case 4:
            return tetraShadowMats.value[bufferOffset];
        default:
            return mat4(1.0);
    }
}

float getClipDist(vec3 positionWorld, uint planeIndex){
    const vec3 lightPos = vec3(-8, 1, 0);

    vec3 normal = tetraShadowPlanes.value[planeIndex];
    return (dot(positionWorld,normal)+dot(-normal,lightPos));
}

vec3 getClipDist(vec3 positionWorld){
    if(uint(meshTaskCullData.values[0].projectionBufferSelect) == 4) {
        uint faceIndex = uint(meshTaskCullData.values[0].projectionBufferOffset);
        uint planeIndex = 3 * faceIndex;
        const vec3 lightPos = vec3(-8, 1, 0);
        
        return vec3(
            getClipDist(positionWorld.xyz, planeIndex),
            getClipDist(positionWorld.xyz, planeIndex + 1),
            getClipDist(positionWorld.xyz, planeIndex + 2)
        );
    }
    else {
        return vec3(1.0);
    }
}

uvec3 GetPerMeshlet(){
	MeshletInfo info = payload.perMeshlet[gl_WorkGroupID.x];
    
    return uvec3(uint(info.index), uint(info.verts), uint(info.tris));
}

uvec2 GetOffsetCount(uint perInvoke, uint count){
    uint offset = perInvoke * gl_LocalInvocationID.x;
    if(offset >= count) {
        return uvec2(0, 0);
    }
    else if(perInvoke + offset > count) {
        perInvoke -= perInvoke + offset - count;
    }
    return uvec2(offset, perInvoke);
}

layout(local_size_x = MESH_LOCAL_SIZE_X, local_size_y = 1) in;
void main(){
    MeshTaskCommand taskCommand = taskCommands.values[payload.taskIndex];

    uint localMeshletIndex = gl_WorkGroupID.x;
    uvec3 info = GetPerMeshlet();

    uint absMeshletIndex = info.x;

    Meshlet meshlet = meshletsBuffer.meshlets[absMeshletIndex];

    if(gl_LocalInvocationID.x == 0){
        SetMeshOutputsEXT(meshlet.vertex_count,meshlet.triangle_count);
    }
    barrier();

    // vertex offset
    uvec2 outVertInfo = GetOffsetCount(info.y, meshlet.vertex_count);

    // trianlge offset
    uvec2 outTriInfo = GetOffsetCount(info.z, meshlet.triangle_count);
    if(outTriInfo.y == 0 && outVertInfo.y == 0) return;

    mat4 viewProjection = getTransform(meshTaskCullData.values[0].projectionBufferSelect, meshTaskCullData.values[0].projectionBufferOffset);
    mat4 modelMatrix = matricesBuffer.matrices[taskCommand.localMatrixIndex].modelMatrix;
    uint vertexOffset = taskCommand.vertexStartIndex + meshlet.vertex_offset + outVertInfo.x;
    vec4 positionWorld;
    vec3 clipDist;
    
    
    for(uint i = 0; i < outVertInfo.y; i++){
        positionWorld = modelMatrix * vec4(vertexPositionBuffer.pos[vertexOffset + i].xyz, 1.0);
        
        clipDist = getClipDist(positionWorld.xyz);
        positionWorld = viewProjection * positionWorld;
        gl_MeshVerticesEXT[outVertInfo.x + i].gl_Position = positionWorld;
        gl_MeshVerticesEXT[outVertInfo.x + i].gl_ClipDistance[0] = clipDist.x;
        gl_MeshVerticesEXT[outVertInfo.x + i].gl_ClipDistance[1] = clipDist.y;
        gl_MeshVerticesEXT[outVertInfo.x + i].gl_ClipDistance[2] = clipDist.z;
        fragUV[outVertInfo.x + i] = vertexTexCoord0Buffer.uv[vertexOffset + i];
        vertexClipNDC[outVertInfo.x + i] = vec3(positionWorld.xy / positionWorld.w, positionWorld.w);
        
    }

    barrier();
    uint indexOffset = taskCommand.triangleStartIndex + meshlet.triangle_offset + (outTriInfo.x * 3);
    uint index;
    uvec3 abc;
    vec3 pa;
    vec3 pb;
    vec3 pc;
    for(uint i = 0; i < outTriInfo.y; i++){
        index = i * 3;
        abc = uvec3(
            uint(indexBuffer.indices[indexOffset + index + 0]),
            uint(indexBuffer.indices[indexOffset + index + 1]),
            uint(indexBuffer.indices[indexOffset + index + 2])
        );

        gl_PrimitiveTriangleIndicesEXT[outTriInfo.x + i] = abc;

        pa = vertexClipNDC[abc.x];
        pb = vertexClipNDC[abc.y];
        pc = vertexClipNDC[abc.z];
        bool behindCamera = (pa.z < 0.0 && pb.z < 0.0 && pc.z < 0.0);
        bool inBounds = ((pa.x > 1.0 && pb.x > 1.0 && pc.x > 1.0) || (pa.x < -1.0 && pb.x < -1.0 && pc.x < -1.0))
                                && ((pa.y > 1.0 && pb.y > 1.0 && pc.y > 1.0) || (pa.y < -1.0 && pb.y < -1.0 && pc.y < -1.0));

        gl_MeshPrimitivesEXT[outTriInfo.x + i].gl_CullPrimitiveEXT = behindCamera || inBounds;
        
    }
}