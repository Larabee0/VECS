<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>VECS</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <StartupObject>VECS.Bootstrap</StartupObject>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
    <BaseOutputPath>../bin</BaseOutputPath>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>

	<PropertyGroup Condition="'$(BuildAll)' != 'false'">
		<DisableFastUpToDateCheck>True</DisableFastUpToDateCheck>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Alimer.Bindings.SDL" Version="3.9.8" />
    <PackageReference Include="AssimpNet" Version="4.1.0" />
    <PackageReference Include="BepuPhysics" Version="2.4.0" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PackageReference Include="TeximpNet" Version="1.4.3" />
    <PackageReference Include="UltralightNet.AppCore" Version="1.3.0" />
    <PackageReference Include="Vortice.SPIRV" Version="1.0.5" />
    <PackageReference Include="Vortice.SPIRV.Reflect" Version="1.0.6" />
    <PackageReference Include="Vortice.Vulkan" Version="3.2.1" />
    <PackageReference Include="Vortice.VulkanMemoryAllocator" Version="1.7.0" />
    <PackageReference Include="YellowDogMan.Mikktspace.Net" Version="0.1.4" />
    <PackageReference Include="Alimer.Bindings.MeshOptimizer" Version="1.2.0" />
  </ItemGroup>
  
  <ItemGroup>
    <EditorConfigFiles Remove="$(SolutionDir)\VECS\.editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(SolutionDir)\VECS\.editorconfig" />
  </ItemGroup>
	
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent" Condition="'$(BuildAll)' != 'false'">
	  <RemoveDir Directories="$(TargetDir)Assets" />
	  <Message Importance="high" text="Cleared output assets directory" />
  </Target>

  <Target Name="ClearSolutionShaders" BeforeTargets="PreBuild" Condition="'$(BuildAll)' != 'false'">
	  <RemoveDir Directories="$(SolutionDir)CompiledShaders" />
	  <Message Importance="high" text="Cleared compiled shaders directory" />
  </Target>

	<Target Name="MakeAssetsDir" AfterTargets="PostBuildEvent" Condition="'$(BuildAll)' != 'false'">
		<MakeDir Directories="$(SolutionDir)CompiledShaders;$(TargetDir)Assets/Shaders;$(TargetDir)Assets/Models;$(TargetDir)Assets/Textures" />
	</Target>


	<Target Name="CopyAssets" AfterTargets="MakeAssetsDir" Condition="'$(BuildAll)' != 'false'">

		<ItemGroup>
			<Assets Include="$(SolutionDir)/Assets/**/*.*" />
		</ItemGroup>
		<Message Importance="high" text="Copying assets to output.." />
		<Copy SourceFiles="@(Assets)" DestinationFolder="$(TargetDir)/Assets/%(RecursiveDir)" />
		<Message Importance="high" text="Asset copy complete" />
	</Target>


	<Target Name="CompileShaders" AfterTargets="CopyAssets" Condition="'$(BuildAll)' != 'false'">

		<ItemGroup>
			<RawShaders Include="$(SolutionDir)/Shaders/**/*.*" Exclude="$(SolutionDir)/Shaders/**/*.glsl" />
		</ItemGroup>

		<Message Importance="high" text="Compiling Shaders.." />
		<Exec Command="$(VULKAN_SDK)/bin/glslc --target-env=vulkan1.4 %(RawShaders.Identity) -o $(SolutionDir)/CompiledShaders/%(RawShaders.Filename)%(RawShaders.Extension).spv" />
		<Message Importance="high" text="Shader Compilation Complete" />
	</Target>

	<Target Name="CopyShaders" AfterTargets="CompileShaders" Condition="'$(BuildAll)' != 'false'">

		<ItemGroup>
			<Shaders Include="$(SolutionDir)/CompiledShaders/*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(Shaders)" DestinationFolder="$(TargetDir)/Assets/Shaders" />
		<Message Importance="high" text="Copied shaders to output directory" />
	</Target>



	<Target Name="BuildAssemblies" AfterTargets="CopyShaders" Condition="'$(BuildAll)' != 'false'">
		<ItemGroup>
			<ProjectFile Include="$(SolutionDir)/**/*.csproj" Exclude="$(SolutionDir)/VECS/VECS.csproj" />
		</ItemGroup>
		<Message Importance="high" text="Compiling subassemblies" />
		<Exec command="dotnet build %(ProjectFile.Identity) --configuration $(Configuration) --property:BuildAll=false" />
	</Target>

</Project>
