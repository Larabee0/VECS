<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>VECS</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <StartupObject>VECS.Bootstrap</StartupObject>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
    <BaseOutputPath>../bin</BaseOutputPath>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>

	<PropertyGroup Condition="'$(BuildAll)' != 'false'">
		<DisableFastUpToDateCheck>True</DisableFastUpToDateCheck>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Alimer.Bindings.SDL" Version="3.9.8" />
    <PackageReference Include="AssimpNetter" Version="6.0.5" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="BCnEncoder.Net.ImageSharp" Version="1.1.3" />
    <PackageReference Include="BepuPhysics" Version="2.4.0" />
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
    <PackageReference Include="Noesis.App" Version="3.2.13" />
    <PackageReference Include="Noesis.App.Theme" Version="3.2.13" />
    <PackageReference Include="Noesis.GUI" Version="3.2.13" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PackageReference Include="Vortice.ShaderCompiler" Version="1.9.0" />
    <PackageReference Include="Vortice.SPIRV" Version="1.0.5" />
    <PackageReference Include="Vortice.SPIRV.Reflect" Version="1.0.6" />
    <PackageReference Include="Vortice.Vulkan" Version="3.2.3" />
    <PackageReference Include="Vortice.VulkanMemoryAllocator" Version="1.7.0" />
    <PackageReference Include="YellowDogMan.Mikktspace.Net" Version="0.1.4" />
    <PackageReference Include="Alimer.Bindings.MeshOptimizer" Version="1.2.1" />
  </ItemGroup>
  
  <ItemGroup>
    <EditorConfigFiles Remove="$(SolutionDir)\VECS\.editorconfig" />
  </ItemGroup>
	
  <ItemGroup>
    <None Include="$(SolutionDir)\VECS\.editorconfig" />
  </ItemGroup>
	
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent" Condition="'$(BuildAll)' != 'false'">
	  <RemoveDir Directories="$(TargetDir)Assets" />
	  <Message Importance="high" text="Cleared output assets directory" />
  </Target>

	<Target Name="CopyAssets" AfterTargets="PostBuildEvent" Condition="'$(BuildAll)' != 'false'">

		<ItemGroup>
			<Assets Include="$(SolutionDir)/Assets/**/*.*" />
		</ItemGroup>
		<Message Importance="high" text="Copying assets to output.." />
		<MakeDir Directories="$(TargetDir)Assets;" />
		<Copy SourceFiles="@(Assets)" DestinationFolder="$(TargetDir)/Assets/%(RecursiveDir)" />
		<Message Importance="high" text="Asset copy complete" />
	</Target>

	<Target Name="BuildAssemblies" AfterTargets="CopyAssets" Condition="'$(BuildAll)' != 'false'">
		<ItemGroup>
			<ProjectFile Include="$(SolutionDir)/**/*.csproj" Exclude="$(SolutionDir)/UltralightNet.Binaries/UltralightNet.Binaries.csproj;$(SolutionDir)/UltralightNet/UltralightNet.csproj;$(SolutionDir)/VECS/VECS.csproj;$(SolutionDir)/UltralightNet.AppCore/UltralightNet.AppCore.csproj;$(SolutionDir)/UltralightNet.AppCore.Binaries/UltralightNet.AppCore.Binaries.csproj" />
		</ItemGroup>
		<Message Importance="high" text="Compiling subassemblies" />
		<Exec command="dotnet build %(ProjectFile.Identity) --configuration $(Configuration) --property:BuildAll=false" />
	</Target>

</Project>
